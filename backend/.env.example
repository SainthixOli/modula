# ============================================
# CONFIGURAÇÕES DO SERVIDOR
# ============================================
PORT=3000
NODE_ENV=production

# ============================================
# CONFIGURAÇÕES DO BANCO DE DADOS (AWS RDS)
# ============================================
DB_HOST=seu-rds-endpoint.region.rds.amazonaws.com
DB_PORT=5432
DB_NAME=modula_db
DB_USER=postgres
DB_PASSWORD=sua-senha-segura-aqui

# ============================================
# SEGURANÇA - JWT
